# Copy to .env.npm-sync and configure before publishing.
# Load with: node --env-file=.env.npm-sync scripts/sync-libraries.mjs
CN_CODER_REGISTRY_URL=https://npm-cn.example.invalid/
EU_CODER_REGISTRY_URL=https://npm-eu.example.invalid/
CN_CODER_NPM_TOKEN=
EU_CODER_NPM_TOKEN=

# Default-list publishing uploads the current batch index to the ailyblockly bucket on both targets.
# RustFS/R2 configuration is also required with --max-repositories; the index replaces existing entries.
RUSTFS_ENDPOINT=https://rustfs.example.invalid/
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: R2_ENDPOINT overrides the endpoint derived from R2_ACCOUNT_ID.
# R2_ENDPOINT=https://r2.example.invalid/
# RUSTFS_REGION=us-east-1
# R2_REGION=auto

# Optional override; otherwise scripts/7za.exe (scripts/7z on other systems) is preferred.
# Leave unset when using the executable in scripts/.
# SEVEN_ZIP_PATH=C:\tools\7za.exe
